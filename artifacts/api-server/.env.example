# API runtime
NODE_ENV=development
PORT=8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a unique random secret (at least 32 bytes). Never commit a real value.
SESSION_SECRET=

# Email notifications via Resend. The sender must be verified in Resend.
RESEND_API_KEY=
# Set this to the signing secret for the Resend webhook targeting /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Notification recipient (doctor/practice inbox).
DOCTOR_EMAIL=care@thepulpdoctor.com
# Verified sender address, e.g. The Pulp Doctor <appointments@your-verified-domain.com>
RESEND_FROM_EMAIL=The Pulp Doctor <appointments@thepulpdoctor.com>

# Private referral attachment storage via Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed browser frontend origins, comma-separated. Keep exact origins only.
APP_ORIGIN=
# Set to "none" for cross-site frontend/API deployments (requires HTTPS).
AUTH_COOKIE_SAME_SITE=lax

# Optional practice site configuration.
PUBLIC_PHONE=
CANCELLATION_CUTOFF_HOURS=0
